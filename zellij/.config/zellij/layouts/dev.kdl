// zjstatus is configured on the `zjstatus` plugin alias in config.kdl,
// so that this file and default.kdl share one definition.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
        children
    }

    tab name="nvim" {
        pane command="zsh" {
            args "-ic" "nvim ."
        }
    }

    // tab name="cursor" {
    //     pane command="agent"
    // }
    tab name="claude" {
        pane command="claude"
    }

    tab name="tuxedo" {
        pane command="zsh" {
            args "-ic" "touch todo.txt && tuxedo"
        }
    }

    tab name="term" {
        pane
    }
}
