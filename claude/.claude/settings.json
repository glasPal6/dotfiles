{
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 310
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); j() { echo \"$input\" | jq -r \"$1 // empty\"; }; out=\"\"; add() { [ -n \"$1\" ] && out=\"${out:+$out | }$1\"; }; pct() { [ -n \"$2\" ] && add \"$1:$(printf '%.0f' \"$2\")%\"; }; model=$(j .model.display_name); dir=$(j .workspace.current_dir); wt=$(j '.workspace.git_worktree // .worktree.name'); adv=$(echo \"$input\" | jq -r '(.advisor | if type==\"object\" then (.display_name // .model // .id // .name) else . end) // empty' 2>/dev/null); [ -z \"$adv\" ] && adv=$(jq -r '.advisorModel // empty' \"$HOME/.claude/settings.json\" 2>/dev/null); ctx=$(j .context_window.used_percentage); h5=$(j .rate_limits.five_hour.used_percentage); d7=$(j .rate_limits.seven_day.used_percentage); br=\"\"; [ -n \"$dir\" ] && br=$(git -C \"$dir\" --no-optional-locks symbolic-ref --short HEAD 2>/dev/null || git -C \"$dir\" --no-optional-locks rev-parse --short HEAD 2>/dev/null); add \"$model\"; [ -n \"$adv\" ] && add \"adv:$adv\"; pct ctx \"$ctx\"; pct 5h \"$h5\"; pct 7d \"$d7\"; [ -n \"$dir\" ] && add \"$(basename \"$dir\")\"; [ -n \"$wt\" ] && add \"wt:$wt\"; add \"$br\"; echo \"$out\""
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  },
  "advisorModel": "opus",
  "theme": "auto"
}
