#!/usr/bin/env zsh
# New tuios session: pick its folder, then type a name (like zellij's zsm).
# Bound to ctrl+space y as a popup in tuios/config.toml.

root=~/Documents
dir=$(
    cd $root && fd -t d --max-depth 3 2>/dev/null |
        fzf --color=dark --layout=reverse --prompt "Folder> " \
            --preview "eza -al --git --color=always --group-directories-first $root/{}"
) || exit 0
[[ -z "$dir" ]] && exit 0
dir=$root/${dir%/}

# Drop late terminal replies (fzf's colour query) so they don't land in the prompt
while read -rs -t 0.05 -k 1; do :; done

# No prefill: vared's suggested text couldn't be deleted inside the popup
read -r "name?Session name: " || exit 0
name=${name//[. ]/_}
[[ -z "$name" ]] && exit 0

# Existing session: just go there
if tuios ls --json | jq -e --arg n "$name" 'any(.[]; .name == $n)' >/dev/null; then
    exec tuios switch-session "$name"
fi

# Space: an existing one (current session's first), a new one, or none
cur_session=${TUIOS_SESSION:-$(tuios session-info --json 2>/dev/null | jq -r '.session_name // empty')}
sessions_json=$(tuios ls --json)
cur_space=$(jq -r --arg s "$cur_session" '.[] | select(.name == $s) | .space // empty' <<<"$sessions_json")
space_choice=$(
    {
        [[ -n "$cur_space" ]] && print -r -- "$cur_space"
        jq -r --arg c "$cur_space" '.[].space // empty | select(. != $c)' <<<"$sessions_json" | sort -u
        print -r -- "(new space...)"
        print -r -- "(none)"
    } | fzf --color=dark --layout=reverse --prompt "Space> "
)
while read -rs -t 0.05 -k 1; do :; done

space=
case "$space_choice" in
    "" | "(none)") ;;
    "(new space...)")
        read -r "space?New space name: " || space=
        space=${space//[. ]/_}
        space=${space:0:64}
        ;;
    *) space=$space_choice ;;
esac

new_args=(--cwd "$dir" --detach)
[[ -n "$space" ]] && new_args+=(--space "$space")
tuios new "$name" "${new_args[@]}" >/dev/null || exit 1

read -q "dev?dev layout? [y/N] "
echo
if [[ "$dev" == y ]]; then
    first=$(tuios list-windows -s "$name" --json | jq -r '.windows[0].window_id')
    tuios-dev-layout "$name" "$dir"
    tuios send-text -s "$name" -w "$first" $'nvim .\n'
fi

exec tuios switch-session "$name"
